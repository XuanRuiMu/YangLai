{
  "name": "yanglai-stage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "2026年动画电影《羊来》宣传直播间",
  "scripts": {
    "predev": "node tools/同步模型.cjs",
    "dev": "vite --host",
    "prebuild": "node tools/同步模型.cjs",
    "build": "vite build && node tools/注入离线缓存.cjs && node tools/体积预算.cjs",
    "预算": "node tools/体积预算.cjs",
    "产物分析": "产物分析=1 vite build && node tools/注入离线缓存.cjs",
    "图标": "node tools/生成图标.cjs",
    "preview": "vite preview --host",
    "模型:体检": "node tools/体检模型.cjs 模型/吴昊阳模型原版.glb",
    "模型:优化": "node tools/优化模型.cjs 模型/吴昊阳模型原版.glb 模型/吴昊阳优化版.glb",
    "模型:轻量": "node tools/生成轻量模型.cjs 模型/吴昊阳模型原版.glb 模型/吴昊阳轻量版.glb",
    "模型:优化主": "node tools/优化主模型.cjs",
    "模型:同步": "node tools/同步模型.cjs",
    "模型:压主页": "node tools/压缩页面.cjs",
    "语音:烘焙": "node tools/烘焙语音.cjs",
    "验证": "node tools/自检.cjs",
    "依赖审计": "npm audit --audit-level=high"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.63.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "vite": "^8.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.1"
  }
}
